/*
 * Menu list, in display order: MENU_ITEM(name, menu ID). Included twice by
 * ui/menu.c, which builds MenuListId[] (internal flash, read everywhere) and
 * MenuListName[] (firmware assets, read only to draw) from the same entries.
 * No include guard on purpose. Names are at most MENU_NAME_SIZE - 1 chars.
 */

