#if defined(ENABLE_FEAT_F4HWN)
MENU_SETTING(MENU_SET_LCK, gSetting_set_lck, 0, SET_LCK_LEN - 1)
#endif
#if defined(ENABLE_FEAT_F4HWN)
MENU_SETTING(MENU_SET_MET, gSetting_set_met, 0, ARRAY_SIZE(gSubMenu_SET_MET) - 1)
#endif
